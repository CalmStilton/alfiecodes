# On the AlfieCodes LXC: /etc/systemd/system/. Pulls new images and restarts
# only containers whose image changed, then removes the old images.
[Unit]
Description=Update AlfieCodes container images
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/docker/alfiecodes
ExecStart=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStart=/usr/bin/docker image prune -f
