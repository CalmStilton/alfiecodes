{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run my project",
      "type": "shell",
      "command": "publish --run \"${relativeFileDirname}\"",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "options": { "statusbar": { "label": "$(play) Run (F5)", "color": "#7CFC9A", "detail": "Try your project in the browser" } },
      "problemMatcher": []
    },
    {
      "label": "Publish my project",
      "type": "shell",
      "command": "publish \"${relativeFileDirname}\"",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "options": { "statusbar": { "label": "$(rocket) Publish (F6)", "color": "#FFD23F", "detail": "Put your project on alfie.lukmor.com" } },
      "problemMatcher": []
    }
  ]
}
